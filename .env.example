NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=site-media

# Server only: use these values OR GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# FIREBASE_USE_APPLICATION_DEFAULT=true

# Generate once with: npm run setup:push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@factory.com
NOTIFICATION_CRON_SECRET=

# Vercel supplies a trusted client IP automatically. On another host, configure
# a trusted reverse proxy to OVERWRITE one single-IP header, then name it here.
# Never enable this while the origin can be reached without that proxy.
# CONTACT_TRUSTED_IP_HEADER=x-real-ip
